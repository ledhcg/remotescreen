/* Vietnamese translation. The key is the exact English source string. */
"Looking for this window on the Mac…" = "Đang tìm cửa sổ này trên máy Mac…";
"This window was closed on the Mac." = "Cửa sổ này đã được đóng trên máy Mac.";
"Choose another window from the launcher." = "Hãy chọn một cửa sổ khác từ trình khởi chạy.";
"Reopen" = "Mở lại";
"Close" = "Đóng";
"Open the desktop to unlock" = "Mở màn hình nền để mở khóa";
"Pair again" = "Ghép nối lại";
"Try again" = "Thử lại";
"Connecting to the Mac…" = "Đang kết nối tới máy Mac…";
"Reconnecting (%lld/%lld)…" = "Đang kết nối lại (%1$lld/%2$lld)…";
"Waiting for the first frame…" = "Đang chờ khung hình đầu tiên…";
"The app was quit on the Mac." = "Ứng dụng đã được thoát trên máy Mac.";
"Reopen the app, or choose another window from the launcher." = "Hãy mở lại ứng dụng, hoặc chọn một cửa sổ khác từ trình khởi chạy.";
"The Mac is locked" = "Máy Mac đang bị khóa";
"Windows cannot be shown while the screen is locked. Unlock the Mac from its desktop." = "Không thể hiển thị cửa sổ khi màn hình bị khóa. Hãy mở khóa máy Mac từ màn hình nền của nó.";
"Screon Helper needs permission on the Mac" = "Screon Helper cần được cấp quyền trên máy Mac";
"Allow Screon Helper to record the screen in System Settings, Privacy & Security." = "Hãy cho phép Screon Helper ghi màn hình trong Cài đặt hệ thống, Quyền riêng tư & Bảo mật.";
"Allow Screon Helper to control the computer in System Settings, Privacy & Security, Accessibility." = "Hãy cho phép Screon Helper điều khiển máy tính trong Cài đặt hệ thống, Quyền riêng tư & Bảo mật, Trợ năng.";
"Allow Screon Helper in System Settings, Privacy & Security, Input Monitoring." = "Hãy cho phép Screon Helper trong Cài đặt hệ thống, Quyền riêng tư & Bảo mật, Giám sát đầu vào.";
"Allow Screon Helper in System Settings, Privacy & Security, Automation." = "Hãy cho phép Screon Helper trong Cài đặt hệ thống, Quyền riêng tư & Bảo mật, Tự động hóa.";
"Allow Screon Helper to use the local network in System Settings, Privacy & Security." = "Hãy cho phép Screon Helper dùng mạng cục bộ trong Cài đặt hệ thống, Quyền riêng tư & Bảo mật.";
"Screon and Screon Helper cannot talk to each other" = "Screon và Screon Helper không thể giao tiếp với nhau";
"Update Screon on this device." = "Hãy cập nhật Screon trên thiết bị này.";
"Update Screon Helper on the Mac." = "Hãy cập nhật Screon Helper trên máy Mac.";
"This device is no longer paired" = "Thiết bị này không còn được ghép nối";
"The Mac removed this device. Pair it again to continue." = "Máy Mac đã gỡ thiết bị này. Hãy ghép nối lại để tiếp tục.";
"This is not the Mac you paired with" = "Đây không phải máy Mac bạn đã ghép nối";
"The Mac's identity changed, or this is another Mac. Pair again only if you trust it." = "Danh tính của máy Mac đã thay đổi, hoặc đây là máy Mac khác. Chỉ ghép nối lại nếu bạn tin tưởng nó.";
"The Mac declined the connection" = "Máy Mac đã từ chối kết nối";
"The person at the Mac did not allow this device." = "Người ngồi tại máy Mac không cho phép thiết bị này.";
"Another connection took over" = "Một kết nối khác đã thay thế";
"This device connected from somewhere else. Try again to take the connection back." = "Thiết bị này đã kết nối từ nơi khác. Hãy thử lại để lấy lại kết nối.";
"Connection lost" = "Mất kết nối";
"Screon could not reach the Mac." = "Screon không thể kết nối tới máy Mac.";
"Typing is blocked by a password field on the Mac" = "Việc gõ phím bị chặn bởi một ô mật khẩu trên máy Mac";
"The Mac can no longer find this window." = "Máy Mac không còn tìm thấy cửa sổ này.";
"The Mac is already streaming as many windows as it allows." = "Máy Mac đang truyền số cửa sổ tối đa cho phép.";
"Screon Helper needs permission to record the screen." = "Screon Helper cần quyền ghi màn hình.";
"The Mac could not start streaming this window. Trying again may help." = "Máy Mac không thể bắt đầu truyền cửa sổ này. Thử lại có thể giúp ích.";

